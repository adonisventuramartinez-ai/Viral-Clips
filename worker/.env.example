SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pon-aqui-tu-secret-key

# GRATIS: una sola llave de Groq sirve para transcribir (Whisper) y elegir los clips (Llama).
# Créala en https://console.groq.com  ->  API Keys  (empieza con gsk_)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional (de pago). Si la pones, Claude elige los clips en vez de Llama.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Fuerza el proveedor: groq | anthropic
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

WHISPER_MODEL=small
LANGUAGE=es
# blur = video completo con fondo difuminado | crop = recorte centrado
CLIP_LAYOUT=blur
# Ruta a cookies.txt de YouTube, si te pide "confirmar que no eres un bot"
COOKIES_FILE=

# --- Modo En vivo (opcionales) ---
SEGMENT_SECONDS=120
REVIEW_MINUTES=2
LIVE_MIN_SCORE=55
