# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (nunca con prefijo NEXT_PUBLIC_). Lo usan las rutas /api.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Contraseña para entrar a la app (invéntala). OBLIGATORIA en Vercel.
APP_PASSWORD=pon-aqui-una-contrasena

# --- Opciones nuevas (todas opcionales) ---
# SEGMENT_SECONDS=45      # trozo de grabación en vivo: más corto = el clip sale antes
# LIVE_MAX_NEW=3          # máx. clips nuevos por cada revisión en vivo
# RERANK=1                # segunda pasada de la IA que re-puntúa candidatos (0 = apagar, gasta menos cupo)
# SNAP_CUTS=1             # cortar el clip en pausas / finales de frase (0 = como antes)

# --- Parte 2: modo En vivo (todas opcionales) ---
# SEGMENT_SECONDS=45      # trozo de grabación: más corto = el clip sale antes (30-60 va bien)
# LIVE_CHAT=1             # leer el chat en vivo de YouTube/Twitch como pista 💬 (0 = apagar)
# LIVE_RECONNECTS=6       # reconexiones seguidas antes de rendirse si el directo se corta
# LIVE_MIN_SCORE=55       # puntaje mínimo para crear un clip en vivo
# WATCH_SECONDS=120       # cada cuánto mira si tus canales automáticos entraron en vivo


# --- Groq: todas las cuentas que quieras (3, 20, 50...). Formas válidas, puedes mezclarlas: ---
# GROQ_KEYS=gsk_cuenta1,gsk_cuenta2,gsk_cuenta3     (separadas por coma)
# GROQ_API_KEY_2=gsk_...   GROQ_API_KEY_3=gsk_...    (una por variable)
# o crea worker/groq_keys.txt con UNA llave por línea (lo más cómodo para 20 cuentas; no se sube a git)
# Si una cuenta se queda sin cupo, el worker pasa solo a la siguiente y reparte el trabajo entre todas.
# LLM_ORDER=groq,gemini,cerebras   # "groq" ya significa TODAS tus cuentas de Groq

# --- Transcripción (Whisper): ayuda con nombres propios y jerga dominicana ---
# CAST_NAMES=Alofoke,Nombre1,Nombre2,Nombre3      # elenco, para que Whisper no los escriba mal
# WHISPER_PROMPT=                                 # (opcional) reemplaza el texto automático
# TRANSCRIBE_CHUNK=600    # segundos por llamada a Whisper (se solapan solos para no cortar palabras)
# ANALYSIS_OVERLAP=90     # segundos de solape entre ventanas que lee la IA

# --- Seguridad del login (app web) ---
# LOGIN_MAX_FAILS=5       # intentos fallidos por IP
# LOGIN_WINDOW_MIN=15     # ... dentro de estos minutos

# --- Parte 3: detección mejorada (todo opcional; 1 = encendido, 0 = apagado) ---
# DETECT_AUDIO=1          # disparos y explosiones por audio (GTA y Juegos)
# DETECT_SCREEN=1         # pantallas WASTED / BUSTED / MISSION PASSED / estrellas de policía (GTA)
# DETECT_ARGUMENT=1       # discusiones (Reality)
# DEDUPE=1                # quitar clips repetidos (otra cámara, mismo momento) en Reality
# DEDUPE_THRESHOLD=0.55   # qué tan parecidos deben ser dos clips para contarlos como repetidos (0.3 a 0.95)
# DEDUPE_HOURS=48         # compara con los clips que creaste en las últimas N horas
# VERIFY_IMAGES=auto      # verificar candidatos con imágenes: auto (GTA, Juegos, Reality) / 1 (siempre) / 0 (apagado)
# VERIFY_TOP=12           # cuántos candidatos se revisan con imágenes (los mejores)
# VERIFY_FRAMES=3         # fotogramas por candidato (2 a 5)
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   # modelo con visión de Groq
