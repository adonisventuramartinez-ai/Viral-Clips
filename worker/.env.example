# Plantilla de worker/.env para la NUEVA cuenta.
# Copia worker/.env.example -> worker/.env y rellena SOLO los valores marcados OBLIGATORIO.
# Nunca subas worker/.env a GitHub (ya está en .gitignore).

# ---------- OBLIGATORIO: apunta al Supabase NUEVO ----------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- IA (obligatorio al menos una llave Groq válida) ----------
GROQ_API_KEY=
LLM_ORDER=groq
HF_TOKEN=

# ---------- Calidad / velocidad ----------
QUALITY=720p
CLIP_SECONDS=45
CLIPS=3
CLIP_PRESET=veryfast
CLIP_MAX_MB=44
CLIP_FOCUS_X=0.5
CLIP_SUB_SIZE=82
CLIP_SUB_OUTLINE=7
CLIP_SUB_SHADOW=5
CLIP_SUB_BLUR=0.3
CLIP_HOOK_SIZE=72
CLIP_MIN_DWELL=4
CLIP_MIN_GAP=3
CLIP_RAMP=0.5
CLIP_MIN_COVERAGE=0.3
SEGMENT_SECONDS=45
CONTENT_TYPE=reality
SMART_START=1
AUTO_QUEUE=1
INTRO_MODE=

# ---------- En vivo ----------
LIVE_MAX_NEW=5
DISCOVER=1
DISCOVER_MAX_PER_DAY=5
FB_AUTOPUBLISH=0

# ---------- Transformar / Crear con IA ----------
TRANSFORM_ALWAYS_ORIGINAL=1
TRANSFORM_DEFAULT_SCORE=75
TRANSFORM_INTRO=1
TRANSFORM_MAX_MB=44
TRANSFORM_MAX_SECONDS=60
IA_CLIPS=4
IA_CLIP_SECONDS=15
IA_TOTAL_SECONDS=60
IA_MAX_RETRIES=3
IA_MAX_WAIT=120
VIRAL_HASHTAG_LIMIT=8
VIRAL_POWER_BOOST=1

# ---------- Cola / logs ----------
QUEUE_MAX_PENDING=50
JOB_MAX_ATTEMPTS=3
LOG_DIR=logs
LOG_MAX_MB=10

# ---------- Sincronía voz/subtítulos ----------
# -0.35 por defecto. -0.5 si se oye antes que el texto; -0.2 si el texto se adelanta.
SUB_SYNC_OFFSET=-0.35
