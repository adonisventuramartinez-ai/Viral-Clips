SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pon-aqui-tu-secret-key

# ============================================================
# IA con CAMBIO AUTOMATICO: el worker usa el primero de la lista.
# Cuando se le acaba el cupo (o falla), pasa solo al siguiente.
# Pon solo las llaves que tengas; las vacias se ignoran.
# Estas llaves van SOLO aqui (worker/.env), NO en Vercel.
# ============================================================

# 1) Groq (gratis, sirve tambien para transcribir) -> https://console.groq.com  (empieza con gsk_)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# 2) Cerebras (gratis) -> https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# 3) Google Gemini (gratis) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 4) Mistral (plan gratis "Experiment") -> https://console.mistral.ai
MISTRAL_API_KEY=
# 5) OpenRouter (modelos ":free") -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
# 6) GitHub Models (token personal, gratis) -> https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=
# Ultimo recurso, DE PAGO (solo se usa si todos los gratis fallan) -> console.anthropic.com
ANTHROPIC_API_KEY=

# Orden de uso (opcional). Quita los que no quieras o cambia el orden.
# groq8b = el mismo Groq pero con un modelo chico: Groq da el cupo aparte por modelo.
LLM_ORDER=groq,cerebras,gemini,mistral,openrouter,github,groq8b,anthropic
# Fuerza uno a ir primero (opcional): groq | cerebras | gemini | mistral | openrouter | github | anthropic
LLM_PROVIDER=
# Si TODOS estan sin cupo, cuantos segundos espera antes de dar error
LLM_MAX_WAIT=180

# Modelos (opcional: los nombres cambian con el tiempo; si uno da 404 al arrancar, cambialo aqui)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GITHUB_MODEL=openai/gpt-4.1-mini
CLAUDE_MODEL=claude-sonnet-5-5

WHISPER_MODEL=small
LANGUAGE=es
# crop = el video llena toda la pantalla vertical (recomendado) | blur = video chico con fondo difuminado
CLIP_LAYOUT=crop
# auto = la camara sigue la cara de quien habla | center = fijo segun CLIP_FOCUS_X
CLIP_FRAMING=auto
# Nitidez: CRF mas bajo = mejor calidad y mas peso (17-20). Nitidez 0 = apagada, 0.5 suave, 1.0 fuerte.
# Preset: veryfast (rapido) | fast | medium | slow (mejor calidad, tarda mas)
CLIP_CRF=18
CLIP_SHARPEN=0.5
CLIP_PRESET=fast
# Encuadre del recorte: 0 = izquierda, 0.5 = centro, 1 = derecha. Si la persona sale cortada, muevelo (ej. 0.3 o 0.7)
CLIP_FOCUS_X=0.5
# Ruta a cookies.txt de YouTube, si te pide "confirmar que no eres un bot"
COOKIES_FILE=

# --- Modo En vivo (opcionales) ---
SEGMENT_SECONDS=120
REVIEW_MINUTES=2
LIVE_MIN_SCORE=55
