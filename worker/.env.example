# Plantilla de worker/.env para la NUEVA cuenta.
# Copia worker/.env.example -> worker/.env y rellena SOLO los valores marcados OBLIGATORIO.
# Nunca subas worker/.env a GitHub (ya está en .gitignore).

# ---------- OBLIGATORIO: apunta al Supabase NUEVO ----------
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Storage de clips en S3 (egress gratis) ----------
# Déjalo en 'supabase' para no cambiar nada. Pon 'r2' cuando ya tengas el bucket creado.
# Solo se mueve el bucket 'clips': 'uploads' sigue en Supabase.
# Tigris: gratis SIN tarjeta → registro https://storage.new , consola https://console.storage.dev
#   R2_ENDPOINT=https://t3.storage.dev
# Cloudflare R2: 10 GB gratis PERO pide método de pago → https://dash.cloudflare.com → R2
#   R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com  (o usa R2_ACCOUNT_ID)
# Backblaze B2: 10 GB gratis SIN tarjeta, bucket privado → https://www.backblaze.com/sign-up/s3
#   R2_ENDPOINT=https://s3.<region>.backblazeb2.com   R2_REGION=<region>
STORAGE_DRIVER=supabase
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CLIPS_BUCKET=clips
R2_REGION=auto

# Web de ClipForge (no es secreto): el worker le pide el token de cada página de Facebook.
WEB_URL=https://viral-clips-nine.vercel.app

# ---------- IA (obligatorio al menos una llave Groq válida) ----------
GROQ_API_KEY=
LLM_ORDER=groq
HF_TOKEN=

# ---------- Calidad / velocidad ----------
QUALITY=1080p
CLIP_SECONDS=45
CLIPS=3
CLIP_PRESET=veryfast
# Directos: render rápido (no aplica CAS/unsharp) para no retrasar la grabación
LIVE_CLIP_PRESET=veryfast
CLIP_MAX_MB=44
CLIP_FOCUS_X=0.5
CLIP_SUB_SIZE=82
CLIP_SUB_OUTLINE=7
CLIP_SUB_SHADOW=5
CLIP_SUB_BLUR=0.3
CLIP_HOOK_SIZE=72
CLIP_MIN_DWELL=3
CLIP_MIN_GAP=3
CLIP_RAMP=0.55
CLIP_MIN_COVERAGE=0.25
CLIP_CAM_DET_W=960
CLIP_CAM_FPS=3.5
CLIP_CAM_FACE_MIN=0.035
CLIP_CAS=0.65
CLIP_SHARPEN=0.35
SEGMENT_SECONDS=45
CONTENT_TYPE=reality
SMART_START=1
HOOK_MAX_SHIFT=6
HOOK_MIN_GAIN=10
AUTO_QUEUE=1
INTRO_MODE=

# ---------- En vivo ----------
LIVE_MIN_HEIGHT=1080
LIVE_MAX_NEW=5
DISCOVER=1
DISCOVER_MAX_PER_DAY=5
FB_AUTOPUBLISH=0

# ---------- Buscador viral (TikTok / Reels) ----------
SEARCH_ACCOUNTS=12
SEARCH_INSPECT=8
SEARCH_MIN_VIEWS=10000
SEARCH_MAX_AGE_HOURS=72
SEARCH_MIN_ENGAGEMENT=1.5
SEARCH_BRAND_FILTER=1
# Perfiles que se usan si la búsqueda no trae ninguno (separados por coma)
SEARCH_SEEDS=

# ---------- Transformar / Crear con IA ----------
TRANSFORM_ALWAYS_ORIGINAL=1
TRANSFORM_DEFAULT_SCORE=75
TRANSFORM_INTRO=cold
TRANSFORM_MAX_MB=44
TRANSFORM_MAX_SECONDS=60
IA_CLIPS=4
IA_CLIP_SECONDS=15
IA_TOTAL_SECONDS=60
IA_MAX_RETRIES=3
IA_MAX_WAIT=120
VIRAL_HASHTAG_LIMIT=8
VIRAL_POWER_BOOST=1

# ---------- Cola / logs ----------
QUEUE_MAX_PENDING=50
JOB_MAX_ATTEMPTS=3
LOG_DIR=logs
LOG_MAX_MB=10

# ---------- Sincronía voz/subtítulos ----------
# -0.35 por defecto. -0.5 si se oye antes que el texto; -0.2 si el texto se adelanta.
SUB_SYNC_OFFSET=-0.35
