# Copiar a C:\DockerVM\vagrant\Vagrantfile
# VM Ubuntu con Docker para correr el worker 24/7 en Windows sin WSL.
# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/bionic64"
  config.vm.hostname = "clipforge-worker"
  config.vm.boot_timeout = 600

  # La carpeta del worker (con .env, work/ y logs/) se monta dentro de la VM en /vagrant
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "C:/Users/nino/Documents/Viral-Clips-1/worker", "/vagrant"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "clipforge-docker"
    vb.memory = 4096
    vb.cpus = 3
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
  end

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y apt-transport-https ca-certificates curl software-properties-common
    apt-get install -y docker.io
    # El docker-compose de bionic (1.17) no entiende el formato 3.7; se reemplaza por 1.29.2
    curl -fsSL "https://github.com/docker/compose/releases/download/1.29.2/docker-compose-Linux-x86_64" -o /usr/local/bin/docker-compose
    chmod +x /usr/local/bin/docker-compose
    usermod -aG docker vagrant
    systemctl enable docker
    systemctl start docker
    docker --version
    docker-compose --version
  SHELL
end
