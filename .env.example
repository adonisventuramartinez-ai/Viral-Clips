# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (nunca con prefijo NEXT_PUBLIC_). Lo usan las rutas /api.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Contraseña para entrar a la app (invéntala). OBLIGATORIA en Vercel.
APP_PASSWORD=pon-aqui-una-contrasena

# --- Storage de clips en S3 (egress gratis) ---
# 'supabase' = sin cambios. 'r2' = los MP4/miniaturas salen del proveedor S3 de abajo.
# Solo se mueven los clips; 'uploads' y los archivos de Facebook siguen en Supabase.
# Tigris: gratis SIN tarjeta → registro https://storage.new , consola https://console.storage.dev
#   R2_ENDPOINT=https://t3.storage.dev
# Cloudflare R2: 10 GB gratis PERO pide método de pago → https://dash.cloudflare.com → R2
#   R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com  (o usa R2_ACCOUNT_ID)
# Backblaze B2: 10 GB gratis SIN tarjeta, bucket privado → https://www.backblaze.com/sign-up/s3
#   R2_ENDPOINT=https://s3.<region>.backblazeb2.com   R2_REGION=<region>
STORAGE_DRIVER=supabase
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CLIPS_BUCKET=clips
R2_REGION=auto
# Opcional: botón "Donar" en la barra superior (link de Ko-fi, MercadoPago, PayPal.me…)
NEXT_PUBLIC_DONATE_URL=


# --- Groq: todas las cuentas que quieras (3, 20, 50...). Formas válidas, puedes mezclarlas: ---
# GROQ_KEYS=gsk_cuenta1,gsk_cuenta2,gsk_cuenta3     (separadas por coma)
# GROQ_API_KEY_2=gsk_...   GROQ_API_KEY_3=gsk_...    (una por variable)
# o crea worker/groq_keys.txt con UNA llave por línea (lo más cómodo para 20 cuentas; no se sube a git)
# Si una cuenta se queda sin cupo, el worker pasa solo a la siguiente y reparte el trabajo entre todas.
# LLM_ORDER=groq,gemini,cerebras   # "groq" ya significa TODAS tus cuentas de Groq

# --- Transcripción (Whisper): ayuda con nombres propios y jerga dominicana ---
# CAST_NAMES=Alofoke,Nombre1,Nombre2,Nombre3      # elenco, para que Whisper no los escriba mal
# WHISPER_PROMPT=                                 # (opcional) reemplaza el texto automático
# TRANSCRIBE_CHUNK=600    # segundos por llamada a Whisper (se solapan solos para no cortar palabras)
# ANALYSIS_OVERLAP=90     # segundos de solape entre ventanas que lee la IA

# --- Seguridad del login (app web) ---
# LOGIN_MAX_FAILS=5       # intentos fallidos por IP
# LOGIN_WINDOW_MIN=15     # ... dentro de estos minutos

# --- Marca de agua (se leen en worker/.env) ---
# WATERMARK_TEXT=@tu_usuario   # texto que aparece como marca de agua en todos los clips
# WATERMARK_POS=br             # posición: tl (arriba-izq), tr (arriba-der), bl (abajo-izq), br (abajo-der), center
# WATERMARK_SIZE=18            # tamaño del texto (12-60)
# WATERMARK_OPACITY=0.6        # opacidad (0.1-1.0)

# --- Modo Transformar (se leen en worker/.env, no en Vercel) ---
# TRANSFORM_MAX_MB=45                     # tope del archivo subido (MB)
# TRANSFORM_MAX_SECONDS=600               # recorte de seguridad para videos largos
# TRANSFORM_DEFAULT_SCORE=78              # puntaje inicial del dramometro
# TRANSFORM_ALWAYS_ORIGINAL=1             # fuerza Modo Original aunque la peticion diga lo contrario
# TRANSFORM_INTRO=card                    # card = tarjeta narrada antes; cold = arranca con el video

# --- Facebook Publisher (se leen en Vercel, seccion /facebook) ---
# FB_APP_ID=tu_app_id
# FB_APP_SECRET=tu_app_secret
# NEXT_PUBLIC_FB_APP_ID=tu_app_id
# NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
# CRON_SECRET=un_secreto_aleatorio
# ADMIN_PASSWORD=tu_contraseña_de_admin (para /facebook/admin)
# SESSION_SECRET=un_secreto_de_al_menos_32_caracteres (para sesiones de Facebook)
# ENCRYPTION_KEY= (alternativa a SESSION_SECRET)
# NEXT_PUBLIC_GRAPH_VERSION=v23.0

# --- Buscador viral (se leen en worker/.env, no en Vercel) ---
# SEARCH_ACCOUNTS=12
# SEARCH_INSPECT=8
# SEARCH_MIN_VIEWS=10000
# SEARCH_MAX_AGE_HOURS=72
# SEARCH_MIN_ENGAGEMENT=1.5
# SEARCH_BRAND_FILTER=1
# SEARCH_SEEDS=

# --- Crear con IA (se leen en worker/.env, no en Vercel) ---
# HF_TOKEN=hf_...                         # obligatorio para /crear-ia (huggingface.co/settings/tokens)
# HF_MODEL=damo-vilab/text-to-video-ms-1.7b
# IA_CLIPS=4                              # escenas (4 x 15 s = 60 s)
# IA_CLIP_SECONDS=15
# IA_TOTAL_SECONDS=60
# IA_MAX_RETRIES=4                        # reintentos por cold start / cupo
# IA_MAX_WAIT=25                          # segundos máx. entre reintentos
# IA_MUSIC_URL=                           # opcional; si no, se sintetiza un pad libre de regalías
# REPLICATE_API_TOKEN=                    # plan B opcional
# REPLICATE_VERSION=owner/model:hash      # requerido con el token de Replicate
